generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  email            String?           @unique
  phone            String?           @unique
  password         String
  isVerified       Boolean           @default(false)
  otp              String?
  otpExpiresAt     DateTime?
  authorization    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isProfilePrivate Boolean           @default(false)
  // Profile Onboarding
  firstName        String?
  lastName         String?
  bio              String?
  bodyType         String?
  bodyShapeUrl     String?
  communities      CommunityMember[]
  syncedContacts   ContactSync[]
    // 👇 Referral fields
  referralCode     String            @unique @default(cuid())
  referredById     Int?
  referredBy       User?             @relation("UserReferredBy", fields: [referredById], references: [id])
  referredUsers    User[]            @relation("UserReferredBy")
  invitesSent      Referral[]        @relation("UserInvites")
  invitesReceived  Referral[]        @relation("UserReferred")
  fcmToken         String?
  notifications     Notification[]
  messages          Message[]
  chats             UserOnChat[]
  minime            Minime[]
  communitiesCreated Community[]  @relation("UserCreatedCommunities")
  media              Media[]      @relation("UserMedia")
  stories            Story[]
  savedStories       SavedStory[]

  friendRequestsSent     Friendship[]    @relation("friendRequestsSent")
  friendRequestsReceived Friendship[]    @relation("friendRequestsReceived")
  blocks                 Block[]         @relation("blocks")
  blockedBy              Block[]         @relation("blocked")
  totalPoints            Int             @default(0)
  Location               Location?
  submissions  Submission[]
  completions  ChallengeCompletion[]
  locationPoints         LocationPoint[]
  firebaseUid   String? 
  LocationHistory LocationHistory[]

  ChatImage ChatImage[]

  Chat Chat[]

  reportsSent Report[] @relation("Reporter")

  reportsReceived Report[] @relation("Reported")

  actedNotifications Notification[] @relation("NotificationActor")

  
  pointsLedger PointsLedger[]
  inventory UserInventory[]
  multipliers ActiveMultiplier[]
  pointBundlePurchases PointBundlePurchase[]
  notificationRedDot   Boolean @default(false)

  // Admin panel fields
  isActive   Boolean  @default(true)
  isBanned   Boolean  @default(false)
  bannedAt   DateTime?
  banReason  String?
}

model Minime {
  id Int @id @default(autoincrement())

  avatarUrl String? @db.Text
  selfieUrl String?
  shirt     String?
  pant      String?
  shoes     String?
  glasses   String?

  lipstick  String?
  jewelry   String?
  bag       String?
  isSaved   Boolean  @default(false)
  isDraft   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
 
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int?
  groupId     Int?
  challengeId Int?
  communityId Int?
  fileUrl     String
  type        String
  chatId      Int?
  createdAt   DateTime @default(now())

  sender    User       @relation("UserMedia", fields: [senderId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
}
enum StoryVisibility {
  private
  profile
}

enum StoryType {
  IMAGE
  VIDEO
}

enum StoryStatus {
  DRAFT
  ACTIVE
  SAVED
  VAULT
}
enum CarSaleStatus {
  ACTIVE
  SOLD
  CANCELLED
}

model Story {
  id         Int             @id @default(autoincrement())
  userId     Int
  mediaUrl   String
  type       StoryType
  visibility StoryVisibility
  status     StoryStatus       @default(DRAFT)
  createdAt  DateTime          @default(now())
  latitude   Float?
  longitude  Float?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy SavedStory[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SavedStory {
  id        Int      @id @default(autoincrement())
  userId    Int
  storyId   Int
  status    StoryStatus
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, status])   
}


model Location {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt
}

model LocationHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}
// schema.prisma — add to LocationPoint
model LocationPoint {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaUrl   String
  placeId    String?         // 👈 NEW: precise de-dupe
  placeName  String?
  latitude   Float?
  longitude  Float?
  points     Int      @default(5)

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, placeId, createdAt]) // 👈 fast same-place checks
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      Int
  actorId     Int?
  type        NotificationType
  title       String
  description String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  // relations
  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id])

  // indexes
  @@index([userId, createdAt])
  @@index([actorId])
  @@index([userId, isRead, createdAt])
}

enum NotificationType {
  FRIEND_ACCEPTED
  FRIEND_REQUEST
  NEW_CHALLENGE
  DAILY_CHALLENGE
  WEEKLY_CHALLENGE
}

model Chat {
  id          Int          @id @default(autoincrement())
  name        String?
  isGroup     Boolean      @default(false)
  isCommunity Boolean      @default(false)
  isLocked    Boolean      @default(false)
  communityId Int?
  community   Community?   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  users       UserOnChat[]

  messages  Message[]
  imageUrl    String?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

    
  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])
}

model Message {
  id       Int     @id @default(autoincrement())
  content  String? @db.LongText
  sender   User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId Int
  chat     Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId   Int
  imageUrl String?

  createdAt DateTime @default(now())
}


model ChatImage {
  id      Int    @id @default(autoincrement())
  userId  Int
  fileUrl String
  user    User   @relation(fields: [userId], references: [id])
}


enum ChatRole {
  ADMIN
  MEMBER
}


model UserOnChat {
  id       Int     @id @default(autoincrement())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  chat     Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId   Int

  // NEW ↓
  role     ChatRole @default(MEMBER)
  joinedAt DateTime @default(now())
  lastSeenMessageId Int?

  isMuted  Boolean  @default(false)
  mutedAt  DateTime?

  @@unique([userId, chatId])
  @@index([chatId, role]) // handy for permission checks like “who are admins in this chat?”
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendshipStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("friendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("friendRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blockedAt DateTime @default(now())

  blocker User @relation("blocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}
enum ChallengeFrequency { 
  DAILY 
  WEEKLY 
  }
enum PointsTier { 
  SILVER 
  GOLD 
  }
model Challenge {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  type           String?
  frequency      ChallengeFrequency
  points         Int      @default(10)
  tier           PointsTier @default(SILVER)
  requiredPhotos Int      @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  submissions    Submission[]
  completions    ChallengeCompletion[]

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)

  @@unique([title, frequency]) // <— add this
}

model Submission {
  id          Int       @id @default(autoincrement())
  userId      Int
  challengeId Int
  mediaUrl    String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  @@index([userId, challengeId, createdAt])
}


model ChallengeCompletion {
  id           Int      @id @default(autoincrement())
  userId       Int
  challengeId  Int
  windowKey    String
  createdAt    DateTime @default(now())
  user         User      @relation(fields: [userId], references: [id])
  challenge    Challenge @relation(fields: [challengeId], references: [id])
  @@unique([userId, challengeId, windowKey])
}
model Community {
  id          Int               @id @default(autoincrement())
  name        String
  
  imageUrl    String?
  creatorId   Int
  creator     User              @relation("UserCreatedCommunities", fields: [creatorId], references: [id])
  members     CommunityMember[]
  chats       Chat[]
  media       Media[] // ✅ inverse of Media.community
}

model CommunityMember {
  id          Int      @id @default(autoincrement())
  userId      Int
  communityId Int
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
    @@index([userId, communityId])

}

model ContactSync {
  id        Int      @id @default(autoincrement())
  userId    Int
  username  String? // optional
  phone     String? // optional
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Report {
  id          Int      @id @default(autoincrement())
  reporterId  Int
  reportedId  Int
  status      String   @default("PENDING")  // PENDING, Reviewed, Resolved
  reason      String?
  adminNote   String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  reporter    User     @relation("Reporter", fields: [reporterId], references: [id])
  reported    User     @relation("Reported", fields: [reportedId], references: [id])
}

enum ShopSlot {
  TOP
  BOTTOM
  SHOES
  GLASSES
  ACCESSORY
}

model ShopItem {
  id        Int       @id @default(autoincrement())
  slot      ShopSlot
  name      String
  brand     String?
  imageUrl  String    @db.Text
  priceUsd  Decimal   @default(0.00) @db.Decimal(10,2)
  // any renderer / style info for avatar
  payload   Json?     // e.g. { "shirt": "Blue Hawaiian" }
  isFeatured Boolean   @default(false)
  appleProductId  String?   @unique   // App Store IAP SKU
  googleProductId String?   @unique   // Play Store IAP SKU

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  inventories UserInventory[]
    @@unique([slot, name])
}

model UserInventory {
  id        Int      @id @default(autoincrement())
  userId    Int
  itemId    Int
  equipped  Boolean  @default(false)
  acquiredAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model MultiplierProduct {
  id        Int      @id @default(autoincrement())
  productId String   @unique // IAP SKU (Apple/Google)
  factor    Float    // e.g. 1.5, 2, 2.5
  hours     Int      // 1, 12, etc.
  priceUsd  Decimal  @db.Decimal(10,2)
  appleProductId  String?   @unique   // App Store IAP SKU
  googleProductId String?   @unique   // Play Store IAP SKU
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActiveMultiplier {
  id           Int      @id @default(autoincrement())
  userId       Int
  factor       Float
  startedAt    DateTime @default(now())
  endsAt       DateTime
  source       String   // "IAP"
  productId    String?  // reference MultiplierProduct.productId
  receiptTxId  String?  // platform transaction id for idempotency

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endsAt])
  @@unique([userId, receiptTxId])
}

model PointsLedger {
  id         Int      @id @default(autoincrement())
  userId     Int
  basePoints Int
  appliedMultiplier Float @default(1)
  finalPoints Int
  reason     String?   // "CHALLENGE_COMPLETION", "LOCATION_UPLOAD", etc.
  refId      Int?      // optional foreign ref
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
model PointBundleProduct {
  id        Int      @id @default(autoincrement())
  productId String   @unique          // e.g. "bundle_10", "bundle_50"
  points    Int
  priceUsd  Decimal  @db.Decimal(10,2)
  isActive  Boolean  @default(true)
  appleProductId  String?   @unique   // App Store IAP SKU
  googleProductId String?   @unique   // Play Store IAP SKU
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PointBundlePurchase {
  id          Int      @id @default(autoincrement())
  userId      Int
  productId   String
  points      Int
  priceUsd    Decimal  @db.Decimal(10,2)
  receiptTxId String?  @unique        // Apple/Google tx id (optional) – idempotency
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum ReferralStatus {
  PENDING
  REWARDED
  CANCELLED
}

model Referral {
  id         Int             @id @default(autoincrement())
  inviterId  Int
  inviteeId  Int
  status     ReferralStatus  @default(PENDING)
  createdAt  DateTime        @default(now())
  rewardedAt DateTime?

  inviter    User @relation("UserInvites",  fields: [inviterId], references: [id], onDelete: Cascade)
  invitee    User @relation("UserReferred", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([inviterId, inviteeId])
  @@unique([inviteeId]) // ➜ একজন ইউজার মাত্র ১বারই রেফার্ড হতে পারবে
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("admin")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}