// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  email         String?   @unique
  phone         String?   @unique
  password      String
  isVerified    Boolean   @default(false)
  otp           String?
  otpExpiresAt  DateTime?
  authorization String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile Onboarding
  firstName    String?
  lastName     String?
  bio          String?
  bodyType     String?
  bodyShapeUrl String?

  messages Message[]
  chats    UserOnChat[]
  minime   Minime[] // ✅ now a list

  media   Media[] @relation("UserMedia") // ✅ Fixed name match
  stories Story[]

  friendRequestsSent     Friendship[] @relation("friendRequestsSent")
  friendRequestsReceived Friendship[] @relation("friendRequestsReceived")
  blocks                 Block[]      @relation("blocks")
  blockedBy              Block[]      @relation("blocked")

  Location Location[]

  LocationHistory LocationHistory[]
}

model Minime {
  id Int @id @default(autoincrement())

  avatarUrl String? @db.Text // URL of selected or generated image
  selfieUrl String? // If user uploads/takes a photo
  shirt     String?
  pant      String?
  shoes     String?
  glasses   String?

  // Female-only
  lipstick String?
  jewelry  String?
  bag      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
  user   User @relation(fields: [userId], references: [id])
}

model Media {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int?
  groupId     Int?
  challengeId Int?
  fileUrl     String
  type        String
  createdAt   DateTime @default(now())

  sender User @relation("UserMedia", fields: [senderId], references: [id]) // ✅ MATCHED name
}

model Story {
  id         Int             @id @default(autoincrement())
  userId     Int
  mediaUrl   String
  type       String
  visibility StoryVisibility  // ✅ enum instead of raw String
  isInVault  Boolean          @default(false)
  createdAt  DateTime         @default(now())
  latitude  Float?   
  longitude Float?   

  user User @relation(fields: [userId], references: [id])
}

enum StoryVisibility {
  private
  profile
}

model Location {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt
}

model LocationHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}


model Chat {
  id        Int          @id @default(autoincrement())
  name      String?
  isGroup   Boolean      @default(false)
  users     UserOnChat[]
  messages  Message[]
  createdAt DateTime     @default(now())
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  Int
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    Int
  createdAt DateTime @default(now())
}

model UserOnChat {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int
  chat   Chat @relation(fields: [chatId], references: [id])
  chatId Int

  @@unique([userId, chatId])
}

// Relations for friend system:

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendshipStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("friendRequestsSent", fields: [requesterId], references: [id])
  receiver  User @relation("friendRequestsReceived", fields: [receiverId], references: [id])

  @@unique([requesterId, receiverId]) // ensure no duplicate direction
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blockedAt DateTime @default(now())

  blocker User @relation("blocks", fields: [blockerId], references: [id])
  blocked User @relation("blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}
