generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  email            String?           @unique
  phone            String?           @unique
  password         String
  isVerified       Boolean           @default(false)
  otp              String?
  otpExpiresAt     DateTime?
  authorization    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  isProfilePrivate Boolean           @default(false)
  // Profile Onboarding
  firstName        String?
  lastName         String?
  bio              String?
  bodyType         String?
  bodyShapeUrl     String?
  communities      CommunityMember[]
  syncedContacts   ContactSync[]


  fcmToken         String?
  notifications     Notification[]
  messages          Message[]
  chats             UserOnChat[]
  minime            Minime[]
  communitiesCreated Community[]  @relation("UserCreatedCommunities")
  media              Media[]      @relation("UserMedia")
  stories            Story[]
  savedStories       SavedStory[]

  friendRequestsSent     Friendship[]    @relation("friendRequestsSent")
  friendRequestsReceived Friendship[]    @relation("friendRequestsReceived")
  blocks                 Block[]         @relation("blocks")
  blockedBy              Block[]         @relation("blocked")
  totalPoints            Int             @default(0)
  Location               Location?
  submissions            Submission[]
  locationPoints         LocationPoint[]
  firebaseUid   String? 
  LocationHistory LocationHistory[]

  ChatImage ChatImage[]

  Chat Chat[]
}

model Minime {
  id Int @id @default(autoincrement())

  avatarUrl String? @db.Text
  selfieUrl String?
  shirt     String?
  pant      String?
  shoes     String?
  glasses   String?

  lipstick  String?
  jewelry   String?
  bag       String?
  isSaved   Boolean  @default(false)
  isDraft   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId Int
 
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Media {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int?
  groupId     Int?
  challengeId Int?
  communityId Int?
  fileUrl     String
  type        String
  createdAt   DateTime @default(now())

  sender    User       @relation("UserMedia", fields: [senderId], references: [id], onDelete: Cascade)
  community Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
}
enum StoryVisibility {
  private
  profile
}

enum StoryType {
  IMAGE
  VIDEO
}

enum StoryStatus {
  DRAFT
  ACTIVE
  SAVED
  VAULT
}

model Story {
  id         Int             @id @default(autoincrement())
  userId     Int
  mediaUrl   String
  type       StoryType
  visibility StoryVisibility
  status     StoryStatus       @default(DRAFT)
  createdAt  DateTime          @default(now())
  latitude   Float?
  longitude  Float?

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedBy SavedStory[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model SavedStory {
  id        Int      @id @default(autoincrement())
  userId    Int
  storyId   Int
  status    StoryStatus
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([userId, storyId, status])   
}


model Location {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  updatedAt DateTime @updatedAt
}

model LocationHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}

model LocationPoint {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  mediaUrl  String
  placeName String?
  latitude  Float?
  longitude Float?
  points    Int     @default(5)

  createdAt DateTime @default(now())
}

model Notification {
  id          Int       @id @default(autoincrement())
  userId      Int
  type        NotificationType
  title       String
  description String?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum NotificationType {
  FRIEND_ACCEPTED
  NEW_CHALLENGE
}

model Chat {
  id          Int          @id @default(autoincrement())
  name        String?
  isGroup     Boolean      @default(false)
  isCommunity Boolean      @default(false)
  communityId Int?
  community   Community?   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  users       UserOnChat[]

  messages  Message[]
  imageUrl    String?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())

    
  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])
}

model Message {
  id       Int     @id @default(autoincrement())
  content  String?
  sender   User    @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId Int
  chat     Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId   Int
  imageUrl String?

  createdAt DateTime @default(now())
}


model ChatImage {
  id      Int    @id @default(autoincrement())
  userId  Int
  fileUrl String
  user    User   @relation(fields: [userId], references: [id])
}


enum ChatRole {
  ADMIN
  MEMBER
}


model UserOnChat {
  id       Int     @id @default(autoincrement())
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int
  chat     Chat    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId   Int

  // NEW ↓
  role     ChatRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([userId, chatId])
  @@index([chatId, role]) // handy for permission checks like “who are admins in this chat?”
}

model Friendship {
  id          Int              @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendshipStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("friendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("friendRequestsReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model Block {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  blockedAt DateTime @default(now())

  blocker User @relation("blocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model Challenge {
  id             Int           @id @default(autoincrement())
  title          String
  description    String? 
  type           ChallengeType
  startDate      DateTime
  endDate        DateTime
  points         Int
  requiredPhotos Int           @default(1)
  createdAt      DateTime      @default(now())
  submissions    Submission[]
}

model Submission {
  id          Int      @id @default(autoincrement())
  userId      Int
  challengeId Int
  mediaUrl    String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
}

enum ChallengeType {
  DAILY
  WEEKLY
}

model Community {
  id          Int               @id @default(autoincrement())
  name        String
  
  imageUrl    String?
  creatorId   Int
  creator     User              @relation("UserCreatedCommunities", fields: [creatorId], references: [id])
  members     CommunityMember[]
  chats       Chat[]
  media       Media[] // ✅ inverse of Media.community
}

model CommunityMember {
  id          Int      @id @default(autoincrement())
  userId      Int
  communityId Int
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
    @@index([userId, communityId])

}

model ContactSync {
  id        Int      @id @default(autoincrement())
  userId    Int
  username  String? // optional
  phone     String? // optional
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
