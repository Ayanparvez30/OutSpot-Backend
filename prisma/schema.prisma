// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  email         String?  @unique
  phone         String?  @unique
  password      String
  isVerified    Boolean  @default(false)
  otp           String?
  otpExpiresAt  DateTime?
  authorization String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
    // Profile Onboarding
  firstName     String?
  lastName      String?
  bio           String?
  bodyType      String?
 bodyShapeUrl   String?

  minime        Minime?
}

model Minime {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique
 avatarUrl String?  @db.Text // URL of selected or generated image
  selfieUrl  String?  // If user uploads/takes a photo
  shirt      String?
  pant       String?
  shoes      String?
  glasses    String?

  // Female-only
  lipstick   String?
  jewelry    String?
  bag        String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id])
}