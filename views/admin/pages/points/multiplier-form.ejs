<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card">
      <div class="card-header"><strong><%= product ? 'Edit Multiplier' : 'Create Multiplier' %></strong></div>
      <div class="card-body">
        <form method="POST" action="<%= product ? `/admin/points/multipliers/${product.id}/edit` : '/admin/points/multipliers/create' %>">
          <div class="mb-3">
            <label class="form-label">Product ID (IAP SKU)</label>
            <input type="text" name="productId" class="form-control" value="<%= product ? product.productId : '' %>" required>
          </div>
          <div class="row mb-3">
            <div class="col">
              <label class="form-label">Factor</label>
              <input type="number" step="0.1" name="factor" class="form-control" value="<%= product ? product.factor : 1.5 %>" required>
            </div>
            <div class="col">
              <label class="form-label">Hours</label>
              <input type="number" name="hours" class="form-control" value="<%= product ? product.hours : 1 %>" required>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col">
              <label class="form-label">Apple Product ID</label>
              <input type="text" name="appleProductId" class="form-control" value="<%= product && product.appleProductId ? product.appleProductId : '' %>" placeholder="com.outspot.mult_2x_1h">
            </div>
            <div class="col">
              <label class="form-label">Google Product ID</label>
              <input type="text" name="googleProductId" class="form-control" value="<%= product && product.googleProductId ? product.googleProductId : '' %>" placeholder="com.outspot.mult_2x_1h">
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><%= product ? 'Update' : 'Create' %></button>
            <a href="/admin/points/multipliers" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
