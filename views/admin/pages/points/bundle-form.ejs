<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card">
      <div class="card-header"><strong><%= bundle ? 'Edit Bundle' : 'Create Bundle' %></strong></div>
      <div class="card-body">
        <form method="POST" action="<%= bundle ? `/admin/points/bundles/${bundle.id}/edit` : '/admin/points/bundles/create' %>">
          <div class="mb-3">
            <label class="form-label">Product ID</label>
            <input type="text" name="productId" class="form-control" value="<%= bundle ? bundle.productId : '' %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Points</label>
            <input type="number" name="points" class="form-control" value="<%= bundle ? bundle.points : '' %>" required>
          </div>
          <div class="row mb-3">
            <div class="col">
              <label class="form-label">Apple Product ID</label>
              <input type="text" name="appleProductId" class="form-control" value="<%= bundle && bundle.appleProductId ? bundle.appleProductId : '' %>" placeholder="com.outspot.bundle_100">
            </div>
            <div class="col">
              <label class="form-label">Google Product ID</label>
              <input type="text" name="googleProductId" class="form-control" value="<%= bundle && bundle.googleProductId ? bundle.googleProductId : '' %>" placeholder="com.outspot.bundle_100">
            </div>
          </div>
          <div class="mb-3 form-check">
            <input type="checkbox" name="isActive" class="form-check-input" id="isActive" <%= bundle ? (bundle.isActive ? 'checked' : '') : 'checked' %>>
            <label class="form-check-label" for="isActive">Active</label>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><%= bundle ? 'Update' : 'Create' %></button>
            <a href="/admin/points/bundles" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
