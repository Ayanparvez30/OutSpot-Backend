<%- include('../../partials/flash') %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card">
      <div class="card-header">
        <strong><%= item ? 'Edit Premade Avatar' : 'Add Premade Avatar' %></strong>
      </div>
      <div class="card-body">
        <form method="POST"
              action="<%= item ? `/admin/premades/${item.id}/edit` : '/admin/premades/create' %>"
              enctype="multipart/form-data">

          <div class="mb-3">
            <label class="form-label">Label</label>
            <input type="text" name="label" class="form-control"
                   value="<%= item ? item.label : '' %>" required
                   placeholder="e.g. Male Fair Skin">
          </div>

          <div class="mb-3">
            <label class="form-label">Gender</label>
            <select name="gender" class="form-select" required>
              <option value="male" <%= item && item.gender === 'male' ? 'selected' : '' %>>Male</option>
              <option value="female" <%= item && item.gender === 'female' ? 'selected' : '' %>>Female</option>
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Avatar Image</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*"
                   <%= item ? '' : 'required' %>>
            <% if (item && item.imageUrl) { %>
              <div class="mt-2">
                <img src="<%= item.imageUrl %>" alt="current"
                     style="max-height:150px;border-radius:8px;background:#f0f0f0;">
                <small class="d-block text-muted mt-1">Current image (upload new to replace)</small>
              </div>
            <% } %>
          </div>

          <div class="mb-3">
            <label class="form-label">Sort Order</label>
            <input type="number" name="sortOrder" class="form-control"
                   value="<%= item ? item.sortOrder : 0 %>" min="0">
            <small class="text-muted">Lower number = shown first</small>
          </div>

          <% if (item) { %>
            <div class="mb-3 form-check">
              <input type="checkbox" name="isActive" class="form-check-input" id="isActive"
                     <%= item.isActive ? 'checked' : '' %>>
              <label class="form-check-label" for="isActive">Active (visible to users)</label>
            </div>
          <% } %>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary"><%= item ? 'Update' : 'Create' %></button>
            <a href="/admin/premades" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
