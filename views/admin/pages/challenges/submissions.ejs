<div class="d-flex justify-content-between align-items-center mb-3">
  <h5>Submissions for: <%= challenge ? challenge.title : 'Challenge' %></h5>
  <span class="text-muted"><%= total %> submissions</span>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>ID</th><th>User</th><th>Media</th><th>Date</th></tr>
      </thead>
      <tbody>
        <% submissions.forEach(s => { %>
          <tr>
            <td><%= s.id %></td>
            <td><a href="/admin/users/<%= s.user.id %>"><%= s.user.username %></a></td>
            <td><a href="<%= s.mediaUrl %>" target="_blank"><img src="<%= s.mediaUrl %>" class="submission-img" alt="submission"></a></td>
            <td><%= s.createdAt.toLocaleString() %></td>
          </tr>
        <% }) %>
        <% if (submissions.length === 0) { %>
          <tr><td colspan="4" class="text-center text-muted py-3">No submissions yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/pagination', { page, totalPages, baseUrl }) %>

<div class="mt-3">
  <a href="/admin/challenges" class="btn btn-outline-secondary">Back to Challenges</a>
</div>
