<div class="d-flex justify-content-between align-items-center mb-3">
  <span class="text-muted"><%= total %> communities</span>
  <form method="GET" action="/admin/communities" class="d-flex gap-2">
    <input type="text" name="q" class="form-control form-control-sm" placeholder="Search..." value="<%= search %>" style="width:200px">
    <button class="btn btn-sm btn-primary">Search</button>
  </form>
</div>

<div class="card">
  <div class="card-body p-0">
    <table class="table table-hover mb-0">
      <thead>
        <tr><th>ID</th><th>Image</th><th>Name</th><th>Creator</th><th>Members</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% communities.forEach(c => { %>
          <tr>
            <td><%= c.id %></td>
            <td>
              <% if (c.imageUrl) { %>
                <img src="<%= c.imageUrl %>" class="avatar-sm" alt="<%= c.name %>">
              <% } else { %>
                <span class="text-muted">-</span>
              <% } %>
            </td>
            <td><%= c.name %></td>
            <td><a href="/admin/users/<%= c.creator.id %>"><%= c.creator.username %></a></td>
            <td><%= c._count.members %></td>
            <td><a href="/admin/communities/<%= c.id %>/edit" class="btn btn-sm btn-outline-primary">Edit</a></td>
          </tr>
        <% }) %>
        <% if (communities.length === 0) { %>
          <tr><td colspan="6" class="text-center text-muted py-3">No communities found.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../../partials/pagination', { page, totalPages, baseUrl }) %>
